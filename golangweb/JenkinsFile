pipeline {

    agent any

    options {
        skipDefaultCheckout(true)      // we do one explicit checkout below
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timeout(time: 30, unit: 'MINUTES')
    }

    environment {
        DOCKER_IMAGE = 'rugvedi/golangweb'
        IMAGE_TAG    = "${BUILD_NUMBER}"
        APP_DIR      = 'golangweb'

        PATH = "C:\\Program Files\\Go\\bin;C:\\Users\\Rugvedi\\AppData\\Local\\Programs\\DockerDesktop\\resources\\bin;${env.PATH}"
    }

    stages {

        stage('Checkout') {
            steps {
                echo 'Checking out source code'
                checkout scm
            }
        }

        stage('Go Build') {
            steps {
                dir("${APP_DIR}") {
                    bat 'go version'
                    bat 'go build -o main.exe .'
                }
            }
        }

        stage('Go Test') {
            steps {
                dir("${APP_DIR}") {
                    bat 'go test ./...'
                }
            }
        }

        stage('Docker Build') {
            steps {
                dir("${APP_DIR}") {
                    bat 'docker build -t %DOCKER_IMAGE%:%IMAGE_TAG% -t %DOCKER_IMAGE%:latest .'
                }
            }
        }

       stage('Login Test') {
    steps {
        withCredentials([usernamePassword(
            credentialsId: 'dockerhub-credentials',
            usernameVariable: 'DOCKER_USER',
            passwordVariable: 'DOCKER_PASS'
        )]) {
            powershell '''
                Write-Host "Running as: $(whoami)"
                Write-Host "User: [$($env:DOCKER_USER)] length: $($env:DOCKER_USER.Length)"
                Write-Host "Password length: $($env:DOCKER_PASS.Length)"

                $sha = [System.Security.Cryptography.SHA256]::Create()
                $hash = ($sha.ComputeHash([Text.Encoding]::UTF8.GetBytes($env:DOCKER_PASS)) | ForEach-Object { $_.ToString('x2') }) -join ''
                Write-Host "Password hash (first 8): $($hash.Substring(0,8))"

                # Test 1: Docker Hub API directly (no docker client involved)
                $body = @{ username = $env:DOCKER_USER; password = $env:DOCKER_PASS } | ConvertTo-Json
                try {
                    Invoke-RestMethod -Method Post -Uri 'https://hub.docker.com/v2/users/login' -ContentType 'application/json' -Body $body | Out-Null
                    Write-Host "TEST 1 Hub API login: OK"
                } catch {
                    Write-Host "TEST 1 Hub API login: FAILED - $($_.Exception.Message)"
                }

                # Test 2: docker login with -p (no pipe)
                docker login -u $env:DOCKER_USER -p $env:DOCKER_PASS 2>&1 | Out-String | Write-Host
                Write-Host "TEST 2 docker login -p exit code: $LASTEXITCODE"
            '''
                }
            }
        }
    }

    post {
        success {
            echo "Pushed ${DOCKER_IMAGE}:${IMAGE_TAG} and ${DOCKER_IMAGE}:latest to Docker Hub."
        }
        failure {
            echo 'Pipeline failed. Check the console output.'
        }
        always {
            // Remove the temporary docker login from the workspace
            powershell '''
                if (Test-Path "$env:WORKSPACE/.docker") {
                    Remove-Item -Recurse -Force "$env:WORKSPACE/.docker"
                }
            '''
            echo 'Jenkins pipeline execution finished.'
        }
    }
}
