
pipeline {

    agent any

    environment {
        DOCKER_IMAGE = 'rugvedi/golangweb'
        IMAGE_TAG = "${BUILD_NUMBER}"

        GO_HOME = 'C:\\Program Files\\Go'

        PATH = "C:\\Program Files\\Go\\bin;C:\\Users\\Rugvedi\\AppData\\Local\\Programs\\DockerDesktop\\resources\\bin;${env.PATH}"
    }

    stages {

        stage('Checkout') {
            steps {
                echo 'Checking out source code'
                checkout scm
            }
        }

        stage('Go Build') {
            steps {
                echo 'Building Golang application'

                dir('golangweb') {
                    bat 'go build -o main.exe .'
                }
            }
        }

        stage('Go Test') {
            steps {
                echo 'Running Go tests'

                dir('golangweb') {
                    bat 'go test ./...'
                }
            }
        }

        stage('Docker Build') {
            steps {
                echo 'Building Docker image'

                dir('golangweb') {
                    bat 'docker build -t %DOCKER_IMAGE%:%IMAGE_TAG% .'
                }
            }
        }

        stage('DockerHub Push') {
            steps {
                echo 'Pushing image to DockerHub'

                withCredentials([usernamePassword(
            credentialsId: 'dockerhub-credentials',
            usernameVariable: 'DOCKER_USER',
            passwordVariable: 'DOCKER_PASS'
        )]) {
            powershell '''
                $env:DOCKER_CONFIG = "$env:WORKSPACE/.docker"
                New-Item -ItemType Directory -Force -Path $env:DOCKER_CONFIG | Out-Null

                Write-Host "User: [$($env:DOCKER_USER)] length: $($env:DOCKER_USER.Length)"
                Write-Host "Password length: $($env:DOCKER_PASS.Length)"

                $env:DOCKER_PASS | docker login -u $env:DOCKER_USER --password-stdin
                if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }

                docker push "$($env:DOCKER_IMAGE):$($env:IMAGE_TAG)"
                if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }

                docker logout
            '''
                }
            }
        }
    }

    post {
        success {
            echo 'CI Pipeline completed successfully!'
            echo 'Docker image pushed to DockerHub.'
        }

        failure {
            echo 'CI Pipeline failed. Check Console Output.'
        }

        always {
            echo 'Jenkins pipeline execution finished.'
        }
    }
}
